# Public site URL — used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://samueladewale.com.ng

# GitHub
NEXT_PUBLIC_GITHUB_USERNAME=aasteri
# Personal access token with `read:user` and `public_repo` scopes.
# Server-only — never expose to the client. Used by /api/github routes.
GITHUB_TOKEN=

# ─── Contact form (cPanel SMTP) ─────────────────────────────────────────
# Where contact-form messages are delivered.
CONTACT_EMAIL=hello@samueladewale.com.ng

# cPanel SSL/TLS settings — recommended. STARTTLS on 587 also works
# (just change SMTP_PORT and the route will set `secure: false`).
SMTP_HOST=mail.samueladewale.com.ng
SMTP_PORT=465
SMTP_USER=hello@samueladewale.com.ng
# IMPORTANT — escape every `$` in the password with a backslash (\$)
# in .env.local. Next.js (`@next/env`) treats `$NAME` as a variable
# reference and silently expands it to empty, which produces an
# auth failure that is hard to debug. Example: a password of
#   Lc5lMQ=%r$ZAk{f]
# must be written here as
#   SMTP_PASS=Lc5lMQ=%r\$ZAk{f]
# On Vercel / production env panels you can paste the raw value
# (those UIs do not perform `$` expansion).
SMTP_PASS=
# Visible "From" header. Display name + <address>. The address part
# should match SMTP_USER so the mail server accepts the relay.
SMTP_FROM="Samuel Adewale Portfolio <hello@samueladewale.com.ng>"

# Set to "1" only if your SMTP server uses a self-signed certificate
# (rare on real cPanel hosts — leave unset in production).
SMTP_INSECURE=
